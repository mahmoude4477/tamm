DATABASE_URL=postgresql://tamm:change-me@localhost:5432/tamm
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=true

# Local development writes email messages to files. Production should use SMTP.
MAIL_TRANSPORT=file
MAIL_DIRECTORY=.data/mail
MAIL_FROM=Tamm <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Persistent storage outside the web root.
UPLOAD_DIRECTORY=.data/uploads

# Scheduled work: generate a separate random token, at least 32 characters.
JOBS_SECRET=
# Optional ClamAV INSTREAM scanner on a trusted internal host.
CLAMAV_HOST=
CLAMAV_PORT=3310
# If SMTP_HOST is an IP, set the hostname on the mail server certificate here.
SMTP_TLS_SERVERNAME=

# Outbound webhooks are disabled unless their exact origins are listed (comma-separated).
WEBHOOK_ALLOWED_ORIGINS=
# Generate a separate 32+ character secret; keep it stable to decrypt webhook signing keys.
WEBHOOK_SECRET_KEY=

# Optional AI: disabled by default. Supports a local Ollama OpenAI-compatible endpoint.
AI_ENABLED=false
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20
